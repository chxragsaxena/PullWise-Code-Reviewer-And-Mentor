# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml and the backend.

POSTGRES_USER=pullwise
POSTGRES_DB=pullwise
POSTGRES_PASSWORD=change-me

# Backend connection string. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgres://pullwise:change-me@localhost:5432/pullwise?sslmode=disable

# Optional: GitHub token (no scopes for public repos); raises the API limit from 60 to 5,000/hour.
GITHUB_TOKEN=

# Optional: Groq API key (console.groq.com/keys) enables the AI pass; unset = deterministic only.
GROQ_API_KEY=

# Optional sign-in: GitHub OAuth App (expiring tokens on), callback URL <PUBLIC_URL>/auth/github/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Required when the client ID is set: 32 random bytes, base64 (openssl rand -base64 32).
SESSION_SECRET=

# Prod compose: PUBLIC_URL is the public address (https + SECURE_COOKIES=true); WEB_PORT the host port.
# PUBLIC_URL=http://localhost:8080
# SECURE_COOKIES=false
# WEB_PORT=8080

# Optional knowledge service (pullwise-knowledge), unset = diff only. Backend run directly:
# KNOWLEDGE_URL=http://localhost:8081
# KNOWLEDGE_JWT_SECRET=      # >= 32 bytes, identical to the knowledge service's JWT_SECRET
# Ask (repository Q&A) needs the knowledge service above. Per-address limits:
# ASK_RATE_PER_MINUTE=10
# ASK_BURST=5
# Optional mutual TLS (certificates from `go run ./cmd/devcerts` in that repo):
# KNOWLEDGE_TLS_CA_FILE=certs/ca.pem
# KNOWLEDGE_TLS_CERT_FILE=certs/client.pem
# KNOWLEDGE_TLS_KEY_FILE=certs/client-key.pem
# Running both in containers (docker-compose.knowledge.yml) uses these instead:
# KNOWLEDGE_JWT_SECRET=
# KNOWLEDGE_DB_PASSWORD=
# COHERE_API_KEY=            # free trial key: dashboard.cohere.com/api-keys
