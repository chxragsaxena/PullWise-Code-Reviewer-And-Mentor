# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml and the backend.

POSTGRES_USER=pullwise
POSTGRES_DB=pullwise
POSTGRES_PASSWORD=change-me

# Backend connection string. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgres://pullwise:change-me@localhost:5432/pullwise?sslmode=disable

# Optional: a GitHub personal access token (no scopes needed for public repos).
# Raises the GitHub API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=

# Optional: a Groq API key (free, no card — console.groq.com/keys). Enables the
# AI review pass (kind: ai checks). Without it, reviews stay deterministic-only.
GROQ_API_KEY=

# Optional: "Sign in with GitHub" (and reviewing your private repos). Create an
# OAuth App at github.com/settings/developers, tick "Expire user access tokens",
# and set its callback URL to <PUBLIC_URL>/auth/github/callback (locally:
# http://localhost:8080/auth/github/callback when running the backend directly).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Required when the client ID is set: 32 random bytes, base64-encoded. Generate with
#   openssl rand -base64 32
SESSION_SECRET=

# Deployment only (docker-compose.prod.yml). PUBLIC_URL is where users reach the
# app; use https plus SECURE_COOKIES=true on a real domain. WEB_PORT is the host port.
# PUBLIC_URL=http://localhost:8080
# SECURE_COOKIES=false
# WEB_PORT=8080

# Optional: the repository knowledge base, a separate service from its own repo
# (pullwise-knowledge). It lets the AI pass see code related to a change from the
# rest of the repository. Without KNOWLEDGE_URL, reviews see only the diff.
#
# Running the backend directly:
# KNOWLEDGE_URL=http://localhost:8081
# KNOWLEDGE_JWT_SECRET=      # >= 32 bytes, identical to the knowledge service's JWT_SECRET
# Optional mutual TLS (certificates from `go run ./cmd/devcerts` in that repo):
# KNOWLEDGE_TLS_CA_FILE=certs/ca.pem
# KNOWLEDGE_TLS_CERT_FILE=certs/client.pem
# KNOWLEDGE_TLS_KEY_FILE=certs/client-key.pem
#
# Running both in containers (docker-compose.knowledge.yml) uses these instead:
# KNOWLEDGE_JWT_SECRET=
# KNOWLEDGE_DB_PASSWORD=
# COHERE_API_KEY=            # the knowledge service embeds with Cohere (free trial key:
#                            # dashboard.cohere.com/api-keys; 1,000 calls/month, 96 texts per call)
