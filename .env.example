# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml and the backend.

POSTGRES_USER=pullwise
POSTGRES_DB=pullwise
POSTGRES_PASSWORD=change-me

# Backend connection string. Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgres://pullwise:change-me@localhost:5432/pullwise?sslmode=disable

# Optional: a GitHub personal access token (no scopes needed for public repos).
# Raises the GitHub API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=
