{
  "framework": "vite",
  "buildCommand": "VITE_API_MODE=http npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pullwise-backend.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://pullwise-backend.onrender.com/auth/:path*" },
    { "source": "/((?!api/|auth/).*)", "destination": "/index.html" }
  ]
}
